# Образ службы бэкапов: тот же Postgres (pg_dump/pg_restore той же версии,
# что и база) плюс rclone для выгрузки в объектное хранилище.
#
# rclone, а не клиент конкретного облака: он говорит по S3-совместимому
# протоколу с любым хранилищем — Google, Amazon, казахстанский провайдер, —
# и при переезде меняется только .env.prod, а не этот файл и не скрипты.
FROM postgres:16-alpine

RUN apk add --no-cache rclone
