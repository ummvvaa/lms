# Боевой контур: deploy/.env.prod. Скопируйте этот файл и заполните.
# В git настоящий .env.prod не попадает никогда (он в .gitignore).
#
# Как читать файл:
#   NAME=            пусто — заполнить обязательно, без этого контур не поднимется
#   # NAME=значение  закомментировано — в коде есть умолчание, оно и действует;
#                    раскомментируйте, только если школа решила иначе.
#                    Пустое значение у такой переменной НЕ равно умолчанию:
#                    оно перебивает его пустой строкой. Не нужно — не трогайте.
#
# Что где взять — в docs/ENV.md, порядок развёртывания — в docs/DEPLOY.md.
# Ничего специфичного для облака здесь нет: при переезде меняются адреса
# и ключи, а не состав переменных.

# --- Домен и веб-сервер ----------------------------------------------------
# домен школы без схемы; по нему Caddy выпускает сертификат Let's Encrypt
SERVER_NAME=
# почта для писем Let's Encrypt об истечении сертификата
CADDY_EMAIL=
# в бою пусто; локальная проверка без домена: «tls internal»
CADDY_TLS=
# адрес админки Django без слэшей, своё слово вместо admin; наружу открыт только он
DJANGO_ADMIN_PATH=
# домены, с которых принимаются запросы, через запятую: school.kz,www.school.kz
DJANGO_ALLOWED_HOSTS=
# те же домены со схемой, через запятую: https://school.kz,https://www.school.kz
CSRF_TRUSTED_ORIGINS=
# адрес, из которого собираются ссылки в письмах: https://school.kz
FRONTEND_BASE_URL=

# --- Django ----------------------------------------------------------------
# всегда config.settings.prod: боевые настройки, DEBUG выключен
DJANGO_SETTINGS_MODULE=config.settings.prod
# сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# в бою всегда 0; настройки prod его и не читают, но пусть будет явно
DJANGO_DEBUG=0
# часовой пояс школы: по нему считаются «сегодня» и час бэкапа
TZ=Asia/Almaty
# уровень журнала бэкенда
# LOG_LEVEL=INFO
# сколько секунд живёт сессия без выхода (12 часов)
# SESSION_COOKIE_AGE=43200
# редирект на https и HSTS: выключать только за чужим TLS-прокси, который делает то же
# SECURE_SSL_REDIRECT=1
# ENABLE_HSTS=1

# --- Школа -----------------------------------------------------------------
# название школы: письма, вход, вкладка браузера
SCHOOL_NAME=
# короткое название для свёрнутого меню
SCHOOL_SHORT_NAME=
# то же название для сборки фронта (читается при сборке образа)
VITE_SCHOOL_NAME=
VITE_SCHOOL_SHORT_NAME=

# --- PostgreSQL ------------------------------------------------------------
# имя базы
POSTGRES_DB=lms
# пользователь базы
POSTGRES_USER=lms
# пароль базы: длинный случайный, наружу база не смотрит
POSTGRES_PASSWORD=
# адрес и порт внутри контура, менять не нужно
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery --------------------------------------------------------
# адрес Redis внутри контура, менять не нужно
REDIS_URL=redis://redis:6379/0

# --- Почта -----------------------------------------------------------------
# SMTP-сервер сервиса рассылок; пусто — письма только в журнал, приглашения не доходят
EMAIL_HOST=
# 587 для STARTTLS, 465 для SSL
EMAIL_PORT=587
# логин и ключ, выданные сервисом рассылок (не ящик Microsoft — их SMTP отключают)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 1 для порта 587
EMAIL_USE_TLS=1
# 1 для порта 465; TLS тогда выключается сам
EMAIL_USE_SSL=0
# секунды ожидания сервера, чтобы зависший SMTP не держал воркер
# EMAIL_TIMEOUT=20
# адрес отправителя; домен должен быть подтверждён у сервиса
DEFAULT_FROM_EMAIL=
# бэкенд почты выбирается сам по наличию EMAIL_HOST — не задавайте
# EMAIL_BACKEND=

# --- Вход и пароли ---------------------------------------------------------
# минимальная длина пароля
# PASSWORD_MIN_LENGTH=10
# сколько минут живёт ссылка на установку пароля
# PASSWORD_LINK_TTL_MINUTES=60
# сколько часов живёт временный пароль, выданный администратором
# TEMP_PASSWORD_TTL_HOURS=72
# сколько минут живёт одноразовая ссылка входа
# MAGIC_LINK_TTL_MINUTES=20
# отдавать ли токен ссылки в ответе API — только для разработки, в бою 0
# MAGIC_LINK_RETURN_TOKEN=0
# предел попыток входа с одного адреса
# LOGIN_RATE=60/min
# сколько неудач за час запирают адрес; порог по записи (5) в коде
# LOGIN_IP_FAILURES=100
# адреса и подсети без блокировки по адресу (школьный выход): 10.0.0.5,192.168.1.0/24
# LOGIN_TRUSTED_NETWORKS=
# предел запросов ссылок на пароль — каждый шлёт письмо
# PASSWORD_LINK_RATE=10/min

# --- Модель ----------------------------------------------------------------
# провайдер модели; без ключа система работает правилами, это штатный режим
# LLM_PROVIDER=anthropic
# ключ провайдера; пусто — модель отключена
LLM_API_KEY=
# адрес API провайдера
# LLM_BASE_URL=https://api.anthropic.com
# какую модель вызывать
# LLM_MODEL=claude-sonnet-5
# секунды ожидания ответа
# LLM_TIMEOUT=60
# сколько раз повторять при временном сбое (429, 5xx)
# LLM_RETRIES=2
# пауза между повторами, секунды
# LLM_RETRY_DELAY=1.0
# признак, что нехранение запросов оговорено с провайдером на уровне учётной записи
# LLM_NO_RETENTION=1
# поиск по официальным сайтам вузов; выключается только целиком
# LLM_SEARCH=1
# сколько поисков разрешено в одном вызове
# LLM_SEARCH_MAX_USES=5
# прейскурант, доллары за миллион токенов — по нему считается стоимость
# LLM_PRICE_INPUT=3
# LLM_PRICE_OUTPUT=15
# цена поиска за тысячу запросов
# LLM_PRICE_SEARCH=10
# месячный лимит расходов в долларах; 0 — лимита нет
# LLM_MONTHLY_LIMIT=0
# предел частоты обращений к модели
# LLM_RATE=20/min
# ниже какой уверенности разбор модели не превращается в предложение
# SUGGESTION_CONFIDENCE_THRESHOLD=0.9

# --- Фоновая сверка дедлайнов ----------------------------------------------
# секунды ожидания сайта вуза
# SYNC_TIMEOUT=20
# кем представляется сверка сайтам вузов
# SYNC_USER_AGENT=SchoolAdmissionsBot/1.0
# домены сверх белого списка справочника, через запятую
# SYNC_EXTRA_HOSTS=

# --- Файлы -----------------------------------------------------------------
# каталог закрытых файлов внутри контейнера; том private_media, менять не нужно
PRIVATE_MEDIA_ROOT=/app/private
# предел одного файла материала, МБ
# MATERIAL_MAX_FILE_MB=15
# сколько файлов у одного материала
# MATERIAL_MAX_FILES=10

# --- Бэкапы ----------------------------------------------------------------
# час ежедневного бэкапа по TZ (0–23)
# BACKUP_HOUR=3
# сколько ежедневных и еженедельных копий хранить
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# в какой день недели откладывать еженедельную копию (1 понедельник … 7 воскресенье)
# BACKUP_WEEKLY_DAY=7
# бакет S3-совместимого хранилища; пусто — бэкап остаётся только на машине
BACKUP_REMOTE_BUCKET=
# адрес хранилища: https://storage.googleapis.com, https://s3.provider.kz и т. п.
BACKUP_REMOTE_ENDPOINT=
# регион, если хранилище его требует (у Google — auto)
BACKUP_REMOTE_REGION=
# ключ и секрет доступа к бакету, только на запись в него
BACKUP_REMOTE_ACCESS_KEY=
BACKUP_REMOTE_SECRET_KEY=
# провайдер для rclone: GCS для Google, AWS для Amazon, Other для прочих S3
# BACKUP_REMOTE_PROVIDER=Other
# папка внутри бакета
# BACKUP_REMOTE_PREFIX=lms

# --- Наблюдаемость ---------------------------------------------------------
# адрес Sentry; пусто — ошибки только в журнал сервера
SENTRY_DSN=
# подпись окружения в Sentry
# SENTRY_ENVIRONMENT=production
# доля запросов с трассировкой
# SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Формулы (умолчания в коде; трогать, только если школа считает иначе) ---
# готовность ученика: веса доменов в сумме 100
# READINESS_W_BEHAVIOR=20
# READINESS_W_ADMISSION=25
# READINESS_W_EXAM=30
# READINESS_W_TALENT=15
# READINESS_W_SPORT=10
# сколько вузов в списке считается целью
# READINESS_TARGET_UNIVERSITIES=3
# сколько активностей считается целью
# READINESS_TALENT_TARGET=3
# сколько соревнований считается целью
# READINESS_SPORT_COMPETITIONS=3
# нижние планки шкал экзаменов в готовности
# READINESS_IELTS_FLOOR=4.0
# READINESS_SAT_FLOOR=400
# портфолио: веса разделов процента заполнения в сумме 100
# PORTFOLIO_W_PROFILE=20
# PORTFOLIO_W_ACADEMICS=25
# PORTFOLIO_W_ACHIEVEMENTS=20
# PORTFOLIO_W_OLYMPIADS=10
# PORTFOLIO_W_SPORT=10
# PORTFOLIO_W_DOCUMENTS=15
# за сколько дней напоминать о событии
# REMIND_EXAM_DAYS=14
# REMIND_DEADLINE_DAYS=14
# REMIND_TASK_DAYS=3
# REMIND_EXAM_TASK_DAYS=30
# REMIND_SCHOLARSHIP_DAYS=21
# сколько дней до дедлайна стипендии считается «ближайшим»
# SCHOLARSHIP_SOON_DAYS=30
# категории результата подбора: границы по проценту соответствия
# MATCH_TIER_SAFETY=90
# MATCH_TIER_MATCH=70
# MATCH_TIER_REACH=45
# соответствие требованиям: веса позиций
# MATCH_W_ENGLISH=30
# MATCH_W_STANDARDIZED=30
# MATCH_W_GPA=25
# MATCH_W_PORTFOLIO=15
# соответствие требованиям: нижние планки шкал
# MATCH_FLOOR_IELTS=4.0
# MATCH_FLOOR_TOEFL=40
# MATCH_FLOOR_SAT=400
# MATCH_FLOOR_ACT=10
# MATCH_FLOOR_GPA=2.0
# сколько XP за действие; за баллы XP не даётся никогда (инвариант №12)
# XP_TASK_DONE=10
# XP_EXERCISE_SOLVED=2
# XP_MOCK_TAKEN=25
# XP_PROFILE_SECTION=15
# XP_ONBOARDING_DONE=50
# XP_ESSAY_SUBMITTED=20
# XP_LEVEL_STEP=100
# сколько учеников отдаётся одной страницей списка
# STUDENT_LIST_LIMIT=500
