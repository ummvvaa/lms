# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
# сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=school.kz,www.school.kz
CSRF_TRUSTED_ORIGINS=https://school.kz,https://www.school.kz
SERVER_NAME=school.kz
FRONTEND_BASE_URL=https://school.kz

# --- Школа ---
# Название школы: письма, вход, вкладка. Короткое — свёрнутый сайдбар.
SCHOOL_NAME=Beta High School
SCHOOL_SHORT_NAME=BHS
# То же название для сборки фронта
VITE_SCHOOL_NAME=Beta High School
VITE_SCHOOL_SHORT_NAME=BHS
LOG_LEVEL=INFO
TZ=Asia/Almaty
ENABLE_HSTS=1
SESSION_COOKIE_AGE=43200

# --- PostgreSQL ---
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0


# --- Почта и вход по ссылке ---
MAGIC_LINK_TTL_MINUTES=20
MAGIC_LINK_RETURN_TOKEN=0
# Почта. Пока EMAIL_HOST пуст, письма пишутся в журнал сервера, а
# у администратора висит предупреждение: приглашения не доходят.
# Берите SMTP сервиса рассылок, а не ящик Microsoft — см. docs/DEPLOY.md.
DEFAULT_FROM_EMAIL=noreply@school.kz
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# 465 — это SSL вместо STARTTLS; включив его, TLS выключать не нужно
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=20
# Бэкенд выбирается сам по наличию EMAIL_HOST — задавать не нужно
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Модель ---
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# Признак того, что нехранение запросов оговорено с провайдером
# на уровне учётной записи. Из запроса это не включается.
LLM_NO_RETENTION=1
# Поиск по официальным сайтам: белый список доменов, дальше него
# модель не ходит. Выключается только целиком.
LLM_SEARCH=1
LLM_SEARCH_MAX_USES=5
SUGGESTION_CONFIDENCE_THRESHOLD=0.9

# --- Фоновая сверка ---
SYNC_TIMEOUT=20
SYNC_USER_AGENT=SchoolAdmissionsBot/1.0 (+https://school.kz)
SYNC_EXTRA_HOSTS=

# --- Бэкапы ---
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# --- Наблюдаемость ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Фронт ---

# Вход по почте и паролю
PASSWORD_MIN_LENGTH=10
PASSWORD_LINK_TTL_MINUTES=60
# Сколько часов живёт временный пароль, выданный администратором.
# Просрочен — администратор выпускает новый одной кнопкой.
TEMP_PASSWORD_TTL_HOURS=72

# --- Материалы олимпиадников (фаза 19) -----------------------------------
# Файлы лежат вне корня веб-сервера и отдаются только через проверку прав.
# В боевом контуре это отдельный том `private_media`, который nginx
# намеренно не монтирует.
PRIVATE_MEDIA_ROOT=/app/private
MATERIAL_MAX_FILE_MB=15
MATERIAL_MAX_FILES=10

# --- Модель (фаза 20) ----------------------------------------------------
# Ключа нет — система работает правилами, это штатный режим.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT=60
LLM_RETRIES=2
LLM_RETRY_DELAY=1.0
# Признак того, что нехранение запросов оговорено с провайдером
# на уровне учётной записи. Из запроса это не включается.
LLM_NO_RETENTION=1
# Прейскурант в долларах за миллион токенов — по нему считается стоимость
LLM_PRICE_INPUT=3
LLM_PRICE_OUTPUT=15
# Поиск оплачивается запросами, а не токенами: цена за тысячу запросов
LLM_PRICE_SEARCH=10
# Месячный лимит расходов, доллары. Ноль — лимита нет.
# При исчерпании операции с моделью отключаются с понятным сообщением.
LLM_MONTHLY_LIMIT=0
# Предел частоты обращений к модели: один цикл в чужом скрипте
# не должен съесть месячный бюджет
LLM_RATE=20/min

# --- TLS и продление сертификата (фаза 21) -------------------------------
# Первый выпуск делается вручную один раз (см. docs/DEPLOY.md), дальше
# служба certbot продлевает сертификат сама.
CERTBOT_EMAIL=admin@school.kz
CERTBOT_INTERVAL_SECONDS=43200
CERTBOT_DRY_RUN_ON_START=1
# До первого выпуска укажите самоподписанный из ./certs:
# SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/certs/privkey.pem

# --- Ограничение частоты запросов ----------------------------------------
LOGIN_RATE=60/min
# Блокировка входа по адресу: сколько неудач за час с одного адреса.
# Порог по учётной записи (5) в коде и не меняется.
LOGIN_IP_FAILURES=100
# Адреса и подсети, для которых блокировка по адресу не действует
# (школьный адрес): через запятую, например 10.0.0.5,192.168.1.0/24
LOGIN_TRUSTED_NETWORKS=
PASSWORD_LINK_RATE=10/min

# --- Боевые настройки ------------------------------------------------------
SECURE_SSL_REDIRECT=1
ENABLE_HSTS=1

# --- Название школы ------------------------------------------------------
# Единственное место, где оно живёт: в коде названия нет (тест это стережёт).
# VITE_* нужны фронту на сборке, остальные — бэкенду.
SCHOOL_NAME=Beta High School
SCHOOL_SHORT_NAME=BHS

# --- Настройка формул ----------------------------------------------------
# Всё ниже — с рабочими значениями по умолчанию. Трогайте, только если
# школа решила считать иначе; пустая строка не годится — уберите строку.

# Готовность ученика: веса доменов (в сумме 100) и цели
READINESS_W_BEHAVIOR=20
READINESS_W_ADMISSION=25
READINESS_W_EXAM=30
READINESS_W_TALENT=15
READINESS_W_SPORT=10
READINESS_TARGET_UNIVERSITIES=3
READINESS_TALENT_TARGET=3
READINESS_SPORT_COMPETITIONS=3
READINESS_IELTS_FLOOR=4.0
READINESS_SAT_FLOOR=400

# Портфолио: веса разделов процента заполнения (в сумме 100).
# Это «сколько ученик о себе рассказал», а не готовность к подаче.
PORTFOLIO_W_PROFILE=20
PORTFOLIO_W_ACADEMICS=25
PORTFOLIO_W_ACHIEVEMENTS=20
PORTFOLIO_W_OLYMPIADS=10
PORTFOLIO_W_SPORT=10
PORTFOLIO_W_DOCUMENTS=15

# Напоминания: за сколько дней предупреждать о событии.
# Свои сроки для экзаменов, дедлайнов вузов и задач; задача
# «Зарегистрироваться на экзамен» появляется за REMIND_EXAM_TASK_DAYS.
REMIND_EXAM_DAYS=14
REMIND_DEADLINE_DAYS=14
REMIND_TASK_DAYS=3
REMIND_EXAM_TASK_DAYS=30

# Соответствие требованиям: веса позиций и нижние планки шкал.
# Планка — начало шкалы экзамена, а не ноль: IELTS 6.0 при пороге 6.5
# это 67%, а не 92%.
MATCH_W_ENGLISH=30
MATCH_W_STANDARDIZED=30
MATCH_W_GPA=25
MATCH_W_PORTFOLIO=15
MATCH_FLOOR_IELTS=4.0
MATCH_FLOOR_TOEFL=40
MATCH_FLOOR_SAT=400
MATCH_FLOOR_ACT=10
MATCH_FLOOR_GPA=2.0

# Сколько XP даётся за действие. За баллы XP не начисляется никогда
# (инвариант №12) — таких переменных здесь нет и быть не может.
XP_TASK_DONE=10
XP_EXERCISE_SOLVED=2
XP_MOCK_TAKEN=25
XP_PROFILE_SECTION=15
XP_ONBOARDING_DONE=50
XP_ESSAY_SUBMITTED=20
XP_LEVEL_STEP=100

# Сколько учеников отдаётся одной страницей списка
STUDENT_LIST_LIMIT=500

# --- Фоновая сверка дедлайнов --------------------------------------------
# Ходим только по белому списку: сайты вузов из справочника и Common App.
# Здесь можно добавить домены сверх него — по одному на школу, не больше.
SYNC_TIMEOUT=20
SYNC_USER_AGENT=SchoolAdmissionsBot/1.0 (+https://school.kz)
SYNC_EXTRA_HOSTS=

# --- Наблюдаемость (по желанию) ------------------------------------------
# Пусто — отправки ошибок нет, всё пишется только в журнал сервера.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# --- Безопасность боевого контура ----------------------------------------
# В бою оба включены. Выключать можно только за чужим TLS-прокси,
# который сам делает то же самое.
SECURE_SSL_REDIRECT=1
ENABLE_HSTS=1

# --- Только для контура разработки ----------------------------------------
# Пароль одноразовых записей браузерного прогона. В бою не используется:
# команда `create_probe_users` при DEBUG=0 отказывается работать, а запись
# `*@probe.local` в бою не входит. Оставьте пустым.
PROBE_PASSWORD=
