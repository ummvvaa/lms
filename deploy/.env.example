# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
CSRF_TRUSTED_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
TZ=Asia/Almaty

# --- PostgreSQL ---
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Microsoft Entra ID ---
# Пусто = вход через Microsoft выключен, работает только ссылка на почту
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Маппинг групп Entra на роли: <guid>:<роль> через запятую.
# Порядок задаёт приоритет, если человек состоит в нескольких группах.
ENTRA_GROUP_ROLE_MAP=
ENTRA_DEFAULT_ROLE=student

# --- Вторая дверь для выпускников ---
MAGIC_LINK_TTL_MINUTES=20
# Только для разработки: вернуть токен прямо в ответе API
MAGIC_LINK_RETURN_TOKEN=0
FRONTEND_BASE_URL=http://localhost:8080
DEFAULT_FROM_EMAIL=noreply@school.kz
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# --- Сессия ---
SESSION_COOKIE_AGE=43200

# --- Фронт ---
VITE_API_TARGET=http://backend:8000
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
