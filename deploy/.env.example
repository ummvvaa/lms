# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
# Адрес админки Django без слэшей. В разработке — обычный admin
# DJANGO_ADMIN_PATH=admin
# Origin, с которых принимаются POST/PATCH. Фронт на 5173, nginx на 8080 —
# нужны оба, иначе после входа каждая запись отбивается 403.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO
TZ=Asia/Almaty

# --- PostgreSQL ---
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Вторая дверь для выпускников ---
MAGIC_LINK_TTL_MINUTES=20
# Только для разработки: вернуть токен прямо в ответе API
MAGIC_LINK_RETURN_TOKEN=0
FRONTEND_BASE_URL=http://localhost:8080
# Бэкенд писем выбирается сам по наличию EMAIL_HOST — задавать не нужно
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Почта ---
# Пока EMAIL_HOST пуст, письма пишутся в журнал сервера и никуда не уходят,
# а у администратора висит предупреждение. Приглашения при этом не работают.
# Берите SMTP сервиса рассылок, а не ящик Microsoft: базовую аутентификацию
# SMTP Microsoft отключает, и настройка перестанет работать без предупреждения.
DEFAULT_FROM_EMAIL=noreply@school.kz
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# 465 — это SSL вместо STARTTLS; включив его, EMAIL_USE_TLS выключать не нужно
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=20
# Задавать не нужно: бэкенд выбирается сам по наличию EMAIL_HOST
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Модель (LLM) ---
# Все переменные модели собраны ниже, в разделе «Модель»: держать их
# в двух местах — верный способ поменять не ту.

# --- Сессия ---
SESSION_COOKIE_AGE=43200

# --- Фронт ---
VITE_API_TARGET=http://backend:8000
# То же название для сборки фронта
VITE_SCHOOL_NAME=Beta High School
VITE_SCHOOL_SHORT_NAME=BHS

# --- Разработческие учётные записи ---------------------------------------
# Заводятся командой `python manage.py create_dev_users` и только при DEBUG.
# Файла со списком паролей в репозитории нет: пароли живут здесь и в .env,
# который в git не попадает.
DEV_STUDENT_PASSWORD=
DEV_BEHAVIOR_PASSWORD=
DEV_ADMISSION_PASSWORD=
DEV_EXAM_PASSWORD=
DEV_TALENT_PASSWORD=
DEV_SPORT_PASSWORD=
DEV_ADMIN_PASSWORD=

# --- Одноразовые записи браузерного прогона ------------------------------
# Семь записей `*@probe.local` заводит `create_probe_users` перед прогоном
# Playwright и убирает `purge_probe_users` после. Только при DEBUG.
# Обычно значение живёт в e2e/.env — прогон передаёт его команде сам.
PROBE_PASSWORD=

# Требования к паролю и срок жизни ссылки на его установку
PASSWORD_MIN_LENGTH=10
PASSWORD_LINK_TTL_MINUTES=2880
# Сколько часов живёт временный пароль, выданный администратором.
# Просрочен — администратор выпускает новый одной кнопкой.
TEMP_PASSWORD_TTL_HOURS=48

# --- Материалы олимпиадников (фаза 19) -----------------------------------
# Файлы лежат вне корня веб-сервера и отдаются только через проверку прав.
# В боевом контуре это отдельный том `private_media`, который nginx
# намеренно не монтирует.
PRIVATE_MEDIA_ROOT=/app/private
# Пределы файлов материалов — на экране «Настройки школы» → «Файлы и подготовка».

# --- Модель --------------------------------------------------------------
# Ключа нет — система работает правилами, это штатный режим.
# Провайдер: openai (по умолчанию) или anthropic — код менять не нужно
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-6-sol
LLM_TIMEOUT=60
LLM_RETRIES=2
LLM_RETRY_DELAY=1.0
# Нехранение запросов: у OpenAI уходит store=false. Журнал злоупотреблений
# (до 30 дней) снимается только договором Zero Data Retention.
LLM_NO_RETENTION=1
# Рассуждающие модели: глубина рассуждения (пусто — не передавать)
# и запас токенов на него сверх предела операции
LLM_REASONING_EFFORT=low
LLM_REASONING_RESERVE=25000
# Поиск по официальным сайтам: белый список доменов, дальше него
# модель не ходит. Выключается только целиком.
LLM_SEARCH=1
LLM_SEARCH_MAX_USES=5
# Прейскурант в долларах за миллион токенов — по нему считается стоимость
LLM_PRICE_INPUT=2
LLM_PRICE_OUTPUT=10
# Поиск оплачивается вызовами: цена за тысячу вызовов
LLM_PRICE_SEARCH=10
# Месячный лимит расходов задаёт администратор на экране «Настройки школы» → «ИИ».
# Предел частоты обращений к модели: один цикл в чужом скрипте
# не должен съесть месячный бюджет
LLM_RATE=20/min
# --- Ограничение частоты запросов ----------------------------------------
LOGIN_RATE=60/min
# Блокировка входа по адресу: сколько неудач за час с одного адреса.
# Порог по учётной записи (5) в коде и не меняется.
LOGIN_IP_FAILURES=100
# Адреса и подсети, для которых блокировка по адресу не действует
# (школьный адрес): через запятую, например 10.0.0.5,192.168.1.0/24
LOGIN_TRUSTED_NETWORKS=
PASSWORD_LINK_RATE=10/min

# --- Название школы ------------------------------------------------------
# Единственное место, где оно живёт: в коде названия нет (тест это стережёт).
# VITE_* нужны фронту на сборке, остальные — бэкенду.
SCHOOL_NAME=Beta High School
SCHOOL_SHORT_NAME=BHS

# --- Настройка формул ----------------------------------------------------
# Всё ниже — с рабочими значениями по умолчанию. Трогайте, только если
# школа решила считать иначе; пустая строка не годится — уберите строку.

# Готовность ученика (веса доменов, планки, цели, баллы внутри доменов)
# и веса разделов портфолио — не здесь: их меняет администратор на экране
# «Настройки школы», разделы «Готовность» и «Портфолио».

# Пороги кабинета куратора (корзины «кого дёргать», резкий скачок, сроки
# документов) — не здесь: их меняет администратор на экране «Настройки школы»

# Сроки напоминаний и окна «скоро» (дедлайны, стипендии) — не здесь:
# их меняет администратор на экране «Настройки школы».

# Соответствие требованиям (веса позиций, нижние планки шкал, границы
# категорий подбора) и потолок списка вузов — не здесь: их меняет
# администратор на экране «Настройки школы», раздел «Соответствие вузам».

# Сколько XP даётся за действие. За баллы XP не начисляется никогда
# (инвариант №12) — таких переменных здесь нет и быть не может.
XP_TASK_DONE=10
XP_EXERCISE_SOLVED=5
XP_MOCK_TAKEN=25
XP_PROFILE_SECTION=15
XP_ONBOARDING_DONE=30
XP_ESSAY_SUBMITTED=20
XP_LEVEL_STEP=100

# --- Фоновая сверка дедлайнов --------------------------------------------
# Ходим только по белому списку: сайты вузов из справочника и Common App.
# Здесь можно добавить домены сверх него — по одному на школу, не больше.
SYNC_TIMEOUT=20
SYNC_USER_AGENT=SchoolAdmissionsBot/1.0 (+https://school.kz)
SYNC_EXTRA_HOSTS=

# --- Наблюдаемость (по желанию) ------------------------------------------
# Пусто — отправки ошибок нет, всё пишется только в журнал сервера.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# --- Безопасность --------------------------------------------------------
# В контуре разработки TLS нет, поэтому оба выключены. В бою — включены,
# см. deploy/.env.prod.example.
SECURE_SSL_REDIRECT=0
ENABLE_HSTS=0

# Ключ шифрования паролей учеников (фаза 65). Пусто — берётся ключ контура разработки
CREDENTIALS_KEY=

# --- Учебная часть ---------------------------------------------------------
# Пороги учёбы («день без причины», посещаемость для «Рисков», окна журнала) —
# не здесь: их меняет администратор на экране «Настройки школы»
# прежние отметки дня считаются только до этой даты (день запуска уроков); пусто — не считаются
# ACADEMICS_DAY_MARKS_UNTIL=

# --- Файлы ДЗ: закрытый бакет Yandex Object Storage в регионе Казахстан ---
# Отдельный бакет (не бакет бэкапов) и свой сервисный аккаунт с доступом только
# к нему — порядок в docs/DEPLOY.md. Пусто — файлы ДЗ лягут на диск сервера.
# Проверка после заполнения: manage.py check_storage
HOMEWORK_S3_BUCKET=
HOMEWORK_S3_ENDPOINT=https://storage.yandexcloud.kz
HOMEWORK_S3_REGION=kz1
HOMEWORK_S3_ACCESS_KEY=
HOMEWORK_S3_SECRET_KEY=
