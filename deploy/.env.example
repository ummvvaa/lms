# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
# Origin, с которых принимаются POST/PATCH. Фронт на 5173, nginx на 8080 —
# нужны оба, иначе после входа каждая запись отбивается 403.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO
TZ=Asia/Almaty

# --- PostgreSQL ---
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# Пусто = вход через Microsoft выключен, работает только ссылка на почту
# Порядок задаёт приоритет, если человек состоит в нескольких группах.

# --- Вторая дверь для выпускников ---
MAGIC_LINK_TTL_MINUTES=20
# Только для разработки: вернуть токен прямо в ответе API
MAGIC_LINK_RETURN_TOKEN=0
FRONTEND_BASE_URL=http://localhost:8080
DEFAULT_FROM_EMAIL=noreply@school.kz
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# --- Модель (LLM) ---
# Пусто = офлайн-режим: разбор идёт правилами, ИИ-объяснения проще, но система работает
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT=60
# просим провайдера не хранить запросы
LLM_NO_RETENTION=1
SUGGESTION_CONFIDENCE_THRESHOLD=0.9

# --- Сессия ---
SESSION_COOKIE_AGE=43200

# --- Фронт ---
VITE_API_TARGET=http://backend:8000

# --- Разработческие учётные записи ---------------------------------------
# Заводятся командой `python manage.py create_dev_users` и только при DEBUG.
# Файла со списком паролей в репозитории нет: пароли живут здесь и в .env,
# который в git не попадает.
DEV_STUDENT_PASSWORD=
DEV_BEHAVIOR_PASSWORD=
DEV_ADMISSION_PASSWORD=
DEV_EXAM_PASSWORD=
DEV_TALENT_PASSWORD=
DEV_SPORT_PASSWORD=
DEV_ADMIN_PASSWORD=

# Требования к паролю и срок жизни ссылки на его установку
PASSWORD_MIN_LENGTH=10
PASSWORD_LINK_TTL_MINUTES=60

# --- Материалы олимпиадников (фаза 19) -----------------------------------
# Файлы лежат вне корня веб-сервера и отдаются только через проверку прав.
# В боевом контуре это отдельный том `private_media`, который nginx
# намеренно не монтирует.
PRIVATE_MEDIA_ROOT=/app/private
MATERIAL_MAX_FILE_MB=15
MATERIAL_MAX_FILES=10
