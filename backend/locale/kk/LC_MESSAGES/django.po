#: core/school_rules.py
msgid "Вес спорта"
msgstr "Спорт салмағы"

#: core/school_rules.py
msgid "Список вузов собран"
msgstr "ЖОО тізімі жиналған"

#: core/school_rules.py
msgid "Полный балл — когда в списке столько вузов, сколько задано целью; меньше — пропорционально"
msgstr "Толық балл — тізімде мақсатта көрсетілгендей ЖОО болғанда; азырақ болса — пропорционалды"

#: core/school_rules.py
msgid "Есть Common App"
msgstr "Common App бар"

#: core/school_rules.py
msgid "Есть аккаунт подачи"
msgstr "Өтінім беру аккаунты бар"

#: core/school_rules.py
msgid "Заявки готовы или поданы"
msgstr "Өтінімдер дайын немесе берілген"

#: core/school_rules.py
msgid "Полный балл — когда готовых, поданных или принятых заявок столько, сколько задано целью"
msgstr "Толық балл — дайын, берілген немесе қабылданған өтінімдер мақсатта көрсетілгендей болғанда"

#: core/school_rules.py
msgid "Полный балл — когда соревнований столько, сколько задано целью; меньше — пропорционально"
msgstr "Толық балл — жарыстар мақсатта көрсетілгендей болғанда; азырақ болса — пропорционалды"

#: core/school_rules.py
msgid "Есть сертификат соревнования"
msgstr "Жарыс сертификаты бар"

#: core/school_rules.py
msgid "Есть роль лидера"
msgstr "Көшбасшы рөлі бар"

#: core/school_rules.py
msgid "Стартовая планка IELTS в готовности"
msgstr "Дайындықтағы IELTS бастапқы межесі"

#: core/school_rules.py
msgid "Стартовая планка SAT в готовности"
msgstr "Дайындықтағы SAT бастапқы межесі"

#: core/school_rules.py
msgid "Прогресс по экзаменам считается от этой планки к личной цели ученика, а не от нуля"
msgstr "Емтихандар бойынша ілгерілеу нөлден емес, осы межеден оқушының жеке мақсатына дейін есептеледі"

#: core/school_rules.py
msgid "Цель по списку вузов"
msgstr "ЖОО тізімі бойынша мақсат"

#: core/school_rules.py
msgid "Столько вузов в списке и столько готовых заявок дают полный балл домена «Поступление»"
msgstr "Тізімдегі осынша ЖОО мен осынша дайын өтінім «Түсу» доменінің толық балын береді"

#: core/school_rules.py
msgid "Цель по активностям"
msgstr "Белсенділіктер бойынша мақсат"

#: core/school_rules.py
msgid "Столько активностей в портфолио дают 100 % домена «Портфолио» в готовности"
msgstr "Портфолиодағы осынша белсенділік дайындықтағы «Портфолио» доменінің 100 %-ын береді"

#: core/school_rules.py
msgid "Цель по соревнованиям"
msgstr "Жарыстар бойынша мақсат"

#: core/school_rules.py
msgid "Столько соревнований дают полный балл за соревнования в домене «Спорт»"
msgstr "Осынша жарыс «Спорт» доменінде жарыстар үшін толық балл береді"

#: core/school_rules.py
msgid "XP и уровни"
msgstr "XP және деңгейлер"

#: core/school_rules.py
msgid "Сколько XP ученик получает за действие и сколько XP в одном уровне"
msgstr "Оқушы әрекет үшін қанша XP алады және бір деңгейде қанша XP бар"

#: core/school_rules.py
msgid "Начисляется один раз за действие. 0 — за это действие XP не даётся. За баллы экзаменов и оценки XP нет"
msgstr "Әрекет үшін бір рет есептеледі. 0 — бұл әрекет үшін XP берілмейді. Емтихан балдары мен бағалар үшін XP жоқ"

#: core/school_rules.py
msgid "XP за выполненную задачу роадмапа"
msgstr "Орындалған роадмап тапсырмасы үшін XP"

#: core/school_rules.py
msgid "XP за решённое упражнение"
msgstr "Шешілген жаттығу үшін XP"

#: core/school_rules.py
msgid "XP за Mock Test онлайн"
msgstr "Онлайн Mock Test үшін XP"

#: core/school_rules.py
msgid "XP за заполненный раздел профиля"
msgstr "Толтырылған профиль бөлімі үшін XP"

#: core/school_rules.py
msgid "XP за эссе, отправленное на проверку"
msgstr "Тексеруге жіберілген эссе үшін XP"

#: core/school_rules.py
msgid "XP за пройденный онбординг"
msgstr "Аяқталған онбординг үшін XP"

#: core/school_rules.py
msgid "XP за ДЗ, сданное в срок"
msgstr "Мерзімінде тапсырылған үй тапсырмасы үшін XP"

#: core/school_rules.py
msgid "XP за материал, прошедший проверку"
msgstr "Тексеруден өткен материал үшін XP"

#: core/school_rules.py
msgid "XP в одном уровне"
msgstr "Бір деңгейдегі XP"

#: core/school_rules.py
msgid "Столько XP нужно на каждый следующий уровень. Уровень ученика пересчитывается по новому шагу сразу, набранные XP не меняются"
msgstr "Әрбір келесі деңгейге осынша XP қажет. Оқушының деңгейі жаңа қадам бойынша бірден қайта есептеледі, жиналған XP өзгермейді"

#: core/school_rules.py
msgid "Опоздание больше N минут считается пропуском"
msgstr "N минуттан артық кешігу сабақты босату деп есептеледі"

#: core/school_rules.py
msgid "0 — правило выключено. Опоздание дольше этого числа минут читается как «н»: урок идёт пропуском в процент посещаемости, в «день без причины», в журнал, выгрузки и отчёты родителям. Отметка учителя не меняется: выключили правило — опоздание снова опоздание. Опоздания без времени прихода остаются опозданиями"
msgstr "0 — ереже өшірулі. Осы минут санынан ұзақ кешігу «ж» болып оқылады: сабақ қатысу пайызына, «себепсіз күнге», журналға, жүктеулерге және ата-аналарға арналған есептерге босату ретінде кіреді. Мұғалімнің белгісі өзгермейді: ережені өшірсеңіз — кешігу қайтадан кешігу болады. Келу уақыты көрсетілмеген кешігулер кешігу болып қалады"

#: core/school_rules.py
msgid "Опоздания в «Рисках»: опозданий за период"
msgstr "«Тәуекелдердегі» кешігулер: кезеңдегі кешігу саны"

#: core/school_rules.py
msgid "0 — правило выключено. Столько опозданий за выбранный в «Рисках» период — ученик попадает в «Риски» с причиной «опоздания». Опоздание, которое по правилу выше считается пропуском, сюда не идёт: оно уже «н»"
msgstr "0 — ереже өшірулі. «Тәуекелдерде» таңдалған кезеңде осынша кешігу болса — оқушы «Тәуекелдерге» «кешігулер» себебімен түседі. Жоғарыдағы ереже бойынша босату деп есептелетін кешігу мұнда кірмейді: ол енді «ж»"

