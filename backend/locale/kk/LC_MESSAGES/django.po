#, python-brace-format
msgid "{where}: ученик «{name}» не найден. Похожие из тех, кого ещё нет в файле: {names} — если это кто-то из них, напишите ФИО как в LMS"
msgstr "{where}: «{name}» оқушысы табылмады. Файлда әлі жоқтардың ішінде ұқсастары: {names} — солардың бірі болса, аты-жөнін LMS-тегідей жазыңыз"

#: academics/subgroup_members.py:482
#, python-brace-format
msgid "{where}: ученик «{name}» не найден — напишите ФИО как в LMS; если ученика в LMS нет, заведите его или уберите строку"
msgstr "{where}: «{name}» оқушысы табылмады — аты-жөнін LMS-тегідей жазыңыз; оқушы LMS-те жоқ болса, оны тіркеңіз немесе жолды алып тастаңыз"

#: core/school_rules.py
msgid "Процент посещаемости, «день без причины», напоминание учителю"
msgstr "Сабаққа қатысу пайызы, «себепсіз күн», мұғалімге еске салу"

#: core/school_rules.py
msgid "Оценки и журнал"
msgstr "Бағалар және журнал"

#: core/school_rules.py
msgid "Кто отстаёт по предмету, окно итогов четверти, журналы без записей"
msgstr "Пән бойынша кім артта қалды, тоқсан қорытындысының терезесі, жазбасы жоқ журналдар"

#: core/school_rules.py
msgid "Пределы файлов, оценки за ДЗ в четвертной, кто не сдаёт вовремя"
msgstr "Файл шектері, ҮТ бағаларының тоқсандық бағаға кіруі, кім уақытында тапсырмайды"

#: core/school_rules.py
msgid "Корзины «кого дёргать», резкий скачок в очереди, сроки документов"
msgstr "«Кімге назар аудару керек» топтамалары, кезектегі күрт секіріс, құжат мерзімдері"

#: core/school_rules.py
msgid "Дедлайны и окна"
msgstr "Дедлайндар және терезелер"

#: core/school_rules.py
msgid "Что считается «скоро», «горит» и «давно» в кабинетах, на главной и у помощника"
msgstr "Кабинеттерде, басты бетте және көмекшіде не «жақында», «шұғыл» және «көптен бері» деп саналады"

#: core/school_rules.py
msgid "Напоминания"
msgstr "Еске салулар"

#: core/school_rules.py
msgid "За сколько дней ученику приходят напоминания и появляются задачи"
msgstr "Оқушыға еске салулар неше күн бұрын келеді және тапсырмалар неше күн бұрын пайда болады"

#: core/school_rules.py
msgid "Файлы и подготовка"
msgstr "Файлдар және дайындық"

#: core/school_rules.py
msgid "Пределы материалов и аудио, размер тренировки, слабая тема"
msgstr "Материал мен аудио шектері, жаттығу көлемі, әлсіз тақырып"


#: core/school_rules.py
msgid "«День без причины»: пропущено уроков не меньше"
msgstr "«Себепсіз күн»: жіберілген сабақ саны кемінде"

#: core/school_rules.py
msgid "День попадает в «Риски» как пропущенный без причины, если «н» за день не меньше этого числа и не меньше доли из правила ниже"
msgstr "Бір күндегі «ж» белгісі осы саннан да, төмендегі ережедегі үлестен де кем болмаса, күн «Тәуекелдерге» себепсіз жіберілген күн ретінде түседі"

#: core/school_rules.py
msgid "«День без причины»: доля пропущенных уроков дня"
msgstr "«Себепсіз күн»: күннің жіберілген сабақтарының үлесі"

#: core/school_rules.py
msgid "Какая часть уроков дня должна быть пропущена без причины. 100 — только если пропущены все уроки дня"
msgstr "Күн сабақтарының қандай бөлігі себепсіз жіберілуі керек. 100 — күннің барлық сабағы жіберілгенде ғана"

#: core/school_rules.py
msgid "Напоминание о неотмеченном уроке"
msgstr "Белгіленбеген сабақ туралы еске салу"


#: core/school_rules.py
msgid "Окно посещаемости у помощника"
msgstr "Көмекшідегі сабаққа қатысу терезесі"

#: core/school_rules.py
msgid "За сколько последних дней помощник считает посещаемость, когда его спрашивают, кто в риске"
msgstr "Кім тәуекелде екенін сұрағанда көмекші сабаққа қатысуды соңғы неше күн бойынша есептейді"

#: core/school_rules.py
msgid "Профиль дисциплины давно не обновлялся"
msgstr "Тәртіп профилі көптен бері жаңартылмаған"

#: core/school_rules.py
msgid "Если отметок уроков у ученика нет, а профиль дисциплины не правили дольше этого срока, помощник называет ученика"
msgstr "Оқушыда сабақ белгілері болмаса, ал тәртіп профилі осы мерзімнен ұзақ өзгертілмесе, көмекші оқушыны атайды"

#: core/school_rules.py
msgid "Окно итогов четверти"
msgstr "Тоқсан қорытындысының терезесі"

#: core/school_rules.py
msgid "За сколько дней до конца четверти учителю в журнале открывается выставление итогов"
msgstr "Тоқсан аяқталғанға дейін неше күн бұрын мұғалімге журналда қорытынды баға қою ашылады"

#: core/school_rules.py
msgid "Журнал без оценок"
msgstr "Бағасы жоқ журнал"

#: core/school_rules.py
msgid "Журнал попадает в список Кымбат, если за столько последних дней уроки шли, а оценок не поставлено ни одной"
msgstr "Соңғы осынша күнде сабақтар өтіп, бірде-бір баға қойылмаса, журнал Кымбат тізіміне түседі"

#: core/school_rules.py
msgid "Окно неотмеченных уроков у куратора"
msgstr "Куратордағы белгіленбеген сабақтар терезесі"

#: core/school_rules.py
msgid "За сколько последних дней куратор видит число уроков своей группы без отметки посещаемости"
msgstr "Куратор өз тобының қатысу белгісі жоқ сабақтарының санын соңғы неше күн бойынша көреді"

#: core/school_rules.py
msgid "Mock Test давно не было"
msgstr "Mock Test көптен бері болмаған"

#: core/school_rules.py
msgid "Последний Mock Test старше этого срока или его не было вовсе — ученик в корзине куратора"
msgstr "Соңғы Mock Test осы мерзімнен ескі немесе мүлде болмаған — оқушы куратор топтамасында"

#: core/school_rules.py
msgid "Экзамен скоро"
msgstr "Емтихан жақын"

#: core/school_rules.py
msgid "Экзамен ближе этого срока, а балл далеко от цели — ученик в корзине «далеко от цели»"
msgstr "Емтихан осы мерзімнен жақын, ал балл мақсаттан алыс — оқушы «мақсаттан алыс» топтамасында"

#: core/school_rules.py
msgid "Отставание от цели по IELTS"
msgstr "IELTS бойынша мақсаттан артта қалу"

#: core/school_rules.py
msgid "До цели не хватает столько баллов или больше — балл считается далёким от цели"
msgstr "Мақсатқа осынша немесе одан көп балл жетпейді — балл мақсаттан алыс деп саналады"

#: core/school_rules.py
msgid "Отставание от цели по SAT"
msgstr "SAT бойынша мақсаттан артта қалу"

#: core/school_rules.py
msgid "Резкий скачок IELTS"
msgstr "IELTS балының күрт секірісі"

#: core/school_rules.py
msgid "Новый балл в очереди отличается от прежнего на столько или больше — строка подсвечена: проверить сертификат"
msgstr "Кезектегі жаңа балл бұрынғысынан осынша немесе одан көп ерекшеленеді — жол белгіленеді: сертификатты тексеру керек"

#: core/school_rules.py
msgid "Резкий скачок SAT"
msgstr "SAT балының күрт секірісі"

#: core/school_rules.py
msgid "Расхождение в очереди"
msgstr "Кезектегі алшақтық"

#: core/school_rules.py
msgid "Новое значение отличается от прежнего на такую долю или больше — у строки чип «Расхождение»"
msgstr "Жаңа мән бұрынғысынан осындай немесе одан үлкен үлеске ерекшеленеді — жолда «Алшақтық» белгісі тұрады"

#: core/school_rules.py
msgid "Документ истекает"
msgstr "Құжат мерзімі аяқталып жатыр"

#: core/school_rules.py
msgid "Подтверждённый документ со сроком считается истекающим за столько дней до срока"
msgstr "Мерзімі бар расталған құжат мерзіміне осынша күн қалғанда мерзімі аяқталып жатқан деп саналады"

#: core/school_rules.py
msgid "Уведомление о сроке документа"
msgstr "Құжат мерзімі туралы хабарландыру"


#: core/school_rules.py
msgid "Задача ученика «скоро срок»"
msgstr "Оқушының «мерзімі жақын» тапсырмасы"

#: core/school_rules.py
msgid "Задача со сроком в ближайшие столько дней стоит на главной куратора в «скоро срок»"
msgstr "Мерзімі алдағы осынша күнде келетін тапсырма куратордың басты бетінде «мерзімі жақын» бөлігінде тұрады"

#: core/school_rules.py
msgid "Срок горит"
msgstr "Мерзім шұғыл"

#: core/school_rules.py
msgid "До срока столько дней или меньше: чип срока у задачи на главной ученика, выделенный дедлайн стипендии"
msgstr "Мерзімге осынша немесе одан аз күн қалды: оқушының басты бетіндегі тапсырманың мерзім белгісі, ерекшеленген стипендия дедлайны"

#: core/school_rules.py
msgid "Скорый дедлайн"
msgstr "Жақын дедлайн"

#: core/school_rules.py
msgid "О дедлайне в ближайшие столько дней говорит дайджест и разбор списка вузов у помощника"
msgstr "Алдағы осынша күндегі дедлайн туралы дайджест пен көмекшінің ЖОО тізімін талдауы айтады"

#: core/school_rules.py
msgid "Ближайшие сроки"
msgstr "Жақын мерзімдер"

#: core/school_rules.py
msgid "Окно «скоро»: срочные дедлайны в кабинете Асем и в планах, ближайшие стипендии, «Скоро» на главной 8–10, СОР и СОЧ у помощника учителя, красный цвет дедлайна у ученика"
msgstr "«Жақында» терезесі: Асем кабинеті мен жоспарлардағы шұғыл дедлайндар, жақын стипендиялар, 8–10-сыныптардың басты бетіндегі «Жақында», мұғалім көмекшісіндегі БЖБ мен ТЖБ, оқушыдағы дедлайнның қызыл түсі"

#: core/school_rules.py
msgid "Горизонт кабинетов"
msgstr "Кабинеттер көкжиегі"

#: core/school_rules.py
msgid "На сколько дней вперёд кабинеты директоров и помощник показывают экзамены, олимпиады, старты и дедлайны; жёлтый цвет дедлайна у ученика"
msgstr "Директорлар кабинеттері мен көмекші емтихандарды, олимпиадаларды, жарыстар мен дедлайндарды неше күн алға көрсетеді; оқушыдағы дедлайнның сары түсі"

#: core/school_rules.py
msgid "Горизонт дашборда поступления"
msgstr "Түсу дашбордының көкжиегі"

#: core/school_rules.py
msgid "На сколько дней вперёд дашборд поступления собирает дедлайны вузов"
msgstr "Түсу дашборды ЖОО дедлайндарын неше күн алға жинайды"

#: core/school_rules.py
msgid "Дедлайны вплотную"
msgstr "Тақау тұрған дедлайндар"

#: core/school_rules.py
msgid "Два дедлайна в списке ученика ближе друг к другу, чем на столько дней, — помощник это отметит"
msgstr "Оқушы тізіміндегі екі дедлайн бір-біріне осынша күннен жақын болса, көмекші мұны атап өтеді"

#: core/school_rules.py
msgid "Ученик давно не входил"
msgstr "Оқушы көптен бері кірмеген"

#: core/school_rules.py
msgid "Не входил дольше этого срока — попадает в число «молчащих» в кабинете Салтанат"
msgstr "Осы мерзімнен ұзақ кірмеген — Салтанат кабинетіндегі «үнсіздер» санына кіреді"

#: core/school_rules.py
msgid "Раунд давно не сверяли"
msgstr "Кезең көптен бері тексерілмеген"

#: core/school_rules.py
msgid "Дедлайн раунда не сверяли с сайтом вуза дольше этого срока — он в счётчике кабинета Асем"
msgstr "Кезең дедлайны ЖОО сайтымен осы мерзімнен ұзақ салыстырылмаған — ол Асем кабинетінің есептегішінде"



#: core/school_rules.py
msgid "Напоминание об экзамене"
msgstr "Емтихан туралы еске салу"

#: core/school_rules.py
msgid "За столько дней до даты экзамена ученику приходит напоминание"
msgstr "Емтихан күніне осынша күн қалғанда оқушыға еске салу келеді"

#: core/school_rules.py
msgid "Напоминание о дедлайне вуза"
msgstr "ЖОО дедлайны туралы еске салу"

#: core/school_rules.py
msgid "За столько дней до дедлайна раунда ученику приходит напоминание"
msgstr "Кезең дедлайнына осынша күн қалғанда оқушыға еске салу келеді"

#: core/school_rules.py
msgid "Напоминание о задаче"
msgstr "Тапсырма туралы еске салу"

#: core/school_rules.py
msgid "За столько дней до срока задачи ученику приходит напоминание"
msgstr "Тапсырма мерзіміне осынша күн қалғанда оқушыға еске салу келеді"

#: core/school_rules.py
msgid "Задача о регистрации на экзамен"
msgstr "Емтиханға тіркелу туралы тапсырма"

#: core/school_rules.py
msgid "За столько дней до даты экзамена у ученика появляется задача о регистрации; то же окно — у списка целей Кымбат"
msgstr "Емтихан күніне осынша күн қалғанда оқушыда тіркелу туралы тапсырма пайда болады; Кымбаттың мақсаттар тізімінде де сол терезе"

#: core/school_rules.py
msgid "Напоминание о стипендии"
msgstr "Стипендия туралы еске салу"

#: core/school_rules.py
msgid "За столько дней до дедлайна стипендии приходит напоминание и появляется задача «Подать»"
msgstr "Стипендия дедлайнына осынша күн қалғанда еске салу келеді және «Өтінім беру» тапсырмасы пайда болады"

#: core/school_rules.py
msgid "Срок задачи о документах"
msgstr "Құжаттар туралы тапсырманың мерзімі"

#: core/school_rules.py
msgid "Задача «донести документы», которую ставит куратор или Асем, получает срок через столько дней"
msgstr "Куратор немесе Асем қоятын «құжаттарды жеткізу» тапсырмасының мерзімі осынша күннен кейін белгіленеді"

#: core/school_rules.py
msgid "Если дата следующего Mock Test не назначена, помощник советует назначить его через столько дней"
msgstr "Келесі Mock Test күні белгіленбесе, көмекші оны осынша күннен кейінге белгілеуді ұсынады"

#: core/school_rules.py
msgid "Предел файла материала"
msgstr "Материал файлының шегі"

#: core/school_rules.py
msgid "Один файл материала олимпиадной группы — не больше. Тот же предел у файла ДЗ, пока хранилище файлов ДЗ не подключено"
msgstr "Олимпиадалық топ материалының бір файлы — осыдан аспайды. ҮТ файлдарының қоймасы қосылмайынша, ҮТ файлының шегі де осындай"

#: core/school_rules.py
msgid "Файлов в одном материале"
msgstr "Бір материалдағы файл саны"

#: core/school_rules.py
msgid "Сколько файлов можно приложить к одному материалу"
msgstr "Бір материалға неше файл тіркеуге болады"

#: core/school_rules.py
msgid "Предел аудио задания"
msgstr "Тапсырма аудиосының шегі"

#: core/school_rules.py
msgid "Аудиофайл к заданию Listening в банке заданий — не больше"
msgstr "Тапсырмалар банкіндегі Listening тапсырмасының аудиофайлы — осыдан аспайды"

#: core/school_rules.py
msgid "Заданий в тренировке"
msgstr "Жаттығудағы тапсырма саны"

#: core/school_rules.py
msgid "Сколько заданий в одной тренировке центра подготовки, если ученик не выбрал иначе"
msgstr "Оқушы басқаша таңдамаса, дайындық орталығының бір жаттығуында неше тапсырма болады"

#: core/school_rules.py
msgid "Слабая тема"
msgstr "Әлсіз тақырып"

#: core/school_rules.py
msgid "Тема в тренажёре считается слабой, если доля верных ответов ниже"
msgstr "Дұрыс жауаптардың үлесі осыдан төмен болса, жаттықтырғыштағы тақырып әлсіз деп саналады"

#: core/school_rules.py
msgid "Месячный лимит расходов на ИИ"
msgstr "ЖИ шығындарының айлық шегі"

#: core/school_rules.py
msgid "В долларах за календарный месяц. Лимит исчерпан — операции с моделью отключаются с понятным текстом. 0 — без лимита"
msgstr "Күнтізбелік айға доллармен. Шек таусылса, модельмен жасалатын операциялар түсінікті мәтінмен өшіріледі. 0 — шексіз"



