msgstr "Алдағы {n} күндегі дедлайндар: {count}."

#: core/school_rules.py
msgid "Соответствие вузам"
msgstr "ЖОО талаптарына сәйкестік"

#: core/school_rules.py
msgid "Веса и планки процента соответствия, границы категорий подбора, потолок списка вузов"
msgstr "Сәйкестік пайызының салмақтары мен төменгі межелері, іріктеу санаттарының шектері, ЖОО тізімінің шегі"

#: core/school_rules.py
msgid "Веса позиций в проценте соответствия"
msgstr "Сәйкестік пайызындағы позициялардың салмақтары"

#: core/school_rules.py
msgid "Сколько весит каждая позиция требований программы. Пара экзаменов (IELTS или TOEFL, SAT или ACT) весит как одна позиция"
msgstr "Бағдарлама талаптарының әр позициясы қанша салмақ алады. Емтихандар жұбы (IELTS немесе TOEFL, SAT немесе ACT) бір позиция ретінде есептеледі"

#: core/school_rules.py
