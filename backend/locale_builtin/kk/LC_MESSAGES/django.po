msgstr "жұмыс факторы"

msgid "checksum"
msgstr "бақылау сомасы"

msgid "content type"
msgstr "мазмұн түрі"

msgid "The groups this user belongs to. A user will get all permissions granted to each of their groups."
msgstr "Пайдаланушы кіретін топтар. Пайдаланушы өз топтарының әрқайсысына берілген барлық рұқсатты алады."

msgid "Specific permissions for this user."
msgstr "Осы пайдаланушының жеке рұқсаттары."

msgid "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only."
msgstr "Міндетті. 150 таңбадан аспауы керек. Тек әріптер, цифрлар және @/./+/-/_ таңбалары."

msgid "email address"
msgstr "электрондық пошта мекенжайы"

#, python-format
msgid "This password is too short. It must contain at least %(min_length)d character."
msgid_plural "This password is too short. It must contain at least %(min_length)d characters."
msgstr[0] "Құпиясөз тым қысқа. Ол кемінде %(min_length)d таңбадан тұруы керек."
msgstr[1] "Құпиясөз тым қысқа. Ол кемінде %(min_length)d таңбадан тұруы керек."

#, python-format
msgid "Your password must contain at least %(min_length)d character."
msgid_plural "Your password must contain at least %(min_length)d characters."
msgstr[0] "Құпиясөз кемінде %(min_length)d таңбадан тұруы керек."
msgstr[1] "Құпиясөз кемінде %(min_length)d таңбадан тұруы керек."

#, python-format
msgid "The password is too similar to the %(verbose_name)s."
msgstr "Құпиясөз «%(verbose_name)s» мәніне тым ұқсас."

msgid "Your password can't be too similar to your other personal information."
msgstr "Құпиясөз басқа жеке деректеріңізге тым ұқсас болмауы керек."

msgid "This password is too common."
msgstr "Бұл құпиясөз тым жиі қолданылады."

msgid "Your password can't be a commonly used password."
msgstr "Құпиясөз жиі қолданылатын құпиясөз болмауы керек."

msgid "This password is entirely numeric."
msgstr "Құпиясөз тек цифрлардан тұрады."

msgid "Your password can't be entirely numeric."
msgstr "Құпиясөз тек цифрлардан тұрмауы керек."

msgid "Enter a valid username. This value may contain only English letters, numbers, and @/./+/-/_ characters."
msgstr "Пайдаланушы атын дұрыс енгізіңіз. Онда тек латын әріптері, цифрлар және @/./+/-/_ таңбалары болуы мүмкін."

msgid "Enter a valid username. This value may contain only letters, numbers, and @/./+/-/_ characters."
msgstr "Пайдаланушы атын дұрыс енгізіңіз. Онда тек әріптер, цифрлар және @/./+/-/_ таңбалары болуы мүмкін."

msgid "Password reset"
msgstr "Құпиясөзді қалпына келтіру"

msgid "Password reset sent"
msgstr "Құпиясөзді қалпына келтіру нұсқаулығы жіберілді"

msgid "Enter new password"
msgstr "Жаңа құпиясөзді енгізіңіз"

msgid "Password reset unsuccessful"
msgstr "Құпиясөзді қалпына келтіру сәтсіз аяқталды"

msgid "Password reset complete"
msgstr "Құпиясөз қалпына келтірілді"

msgid "Password change"
msgstr "Құпиясөзді өзгерту"

msgid "Password change successful"
msgstr "Құпиясөз сәтті өзгертілді"

msgid "Content Types"
msgstr "Мазмұн түрлері"

#, python-format
msgid "Content type %(ct_id)s object has no associated model"
msgstr "%(ct_id)s мазмұн түрінің нысанына байланысты модель жоқ"

#, python-format
msgid "Content type %(ct_id)s object %(obj_id)s doesn't exist"
msgstr "%(ct_id)s мазмұн түрінің %(obj_id)s нысаны жоқ"

#, python-format
msgid "%(ct_name)s objects don't have a get_absolute_url() method"
msgstr "%(ct_name)s нысандарында get_absolute_url() әдісі жоқ"
