# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Отчёты о покрытии: считаются заново на каждой машине
htmlcov/
.coverage
.coverage.*
backend/staticfiles/
backend/media/
# закрытые файлы материалов олимпиадников
backend/private/
# Локальные дампы базы: в них персональные данные учеников
*.sqlite3
*.dump
*.sql.gz
backend/dumps/

# Node
node_modules/
dist/
build/
.vite/
.eslintcache
*.tsbuildinfo

# Секреты и локальное
# .env.prod содержит боевые пароли и ключи — в репозиторий не попадает,
# в git лежит только .env.prod.example
deploy/.env
deploy/.env.prod
.env
# настройки бренда без секретов: название школы для сборки фронта
!frontend/.env
*.local
# настройки Claude Code: общие лежат в git, личные — нет
.claude/settings.local.json

# ОС и редакторы
.DS_Store
.idea/
.vscode/
*~
*.bak
*.orig

# Посторонние артефакты
*.vsix
*.log
# снимки и логи браузера, снятые вручную через MCP
.playwright-mcp/

# Пароли разработческих учёток в репозиторий не попадают:
# аккаунты заводит management-команда, пароли берутся из окружения
docs/TEST_ACCOUNTS*

# Браузерные проверки
e2e/node_modules/
e2e/report/
e2e/test-results/
e2e/audit-findings/
e2e/audit-report.json
e2e/.auth/
e2e/.env
e2e/__pycache__/
# Снимки экранов, включая эталоны сравнения раскладки: весят десятки
# мегабайт и снимаются заново на своей машине (порядок — в README)
e2e/shots/
playwright-report/
test-results/
CLAUDE.md
docs/
.claude/
